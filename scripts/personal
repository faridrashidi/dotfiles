#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PRIVATE_DOTFILES_DIR="${HOME}/Dropbox/Resources/Mac/Settings/Dotfiles"
PRIVATE_APPS_SOURCE="${PRIVATE_DOTFILES_DIR}/scripts/apps-private"
PRIVATE_APPS_TARGET="${SCRIPT_DIR}/apps-private"

# Requires external files
if [[ -f "$PRIVATE_APPS_SOURCE" && ! -e "$PRIVATE_APPS_TARGET" && ! -L "$PRIVATE_APPS_TARGET" ]]; then
    ln -s "$PRIVATE_APPS_SOURCE" "$PRIVATE_APPS_TARGET"
fi

"${SCRIPT_DIR}/apps" --install
"${SCRIPT_DIR}/systems" --install \
    --lock-message "If found, please call 000-000-0000." \
    --languages "en" "fa" \
    --input-sources "U.S." "Persian-ISIRI 2901" \
    --new-window-target-path "${HOME}/Dropbox/Projects" \
    --browser "brave" \
    --favorites-paths \
        "${HOME}/Dropbox/Inbox" \
        "${HOME}/Dropbox/Projects" \
        "${HOME}/Developer" \
        "${HOME}/Dropbox" \
        "${HOME}/Downloads" \
        "${HOME}/Desktop" \
        "${HOME}/Dropbox/Archive" \
        "${HOME}/Dropbox/Resources"
"${SCRIPT_DIR}/skm" --install

zsh <<'ZSH'
setopt ERR_EXIT
source "${HOME}/.config/zsh/functions.zsh"
finder-sidebar-icon ~/Dropbox/Inbox tray.full
finder-sidebar-icon ~/Dropbox/Projects folder.badge.gearshape
finder-sidebar-icon ~/Dropbox shippingbox.fill
finder-sidebar-icon ~/Dropbox/Archive archivebox.fill
finder-sidebar-icon ~/Dropbox/Resources books.vertical.fill
ZSH

dooti apply --dynamic

install -d -m 0700 "${HOME}/.ssh"
if [[ -d "${PRIVATE_DOTFILES_DIR}/ssh" ]]; then
    rsync -a "${PRIVATE_DOTFILES_DIR}/ssh/" "${HOME}/.ssh/"
fi
if [[ -d "${PRIVATE_DOTFILES_DIR}/plists" ]]; then
    "${SCRIPT_DIR}/plists" --install --dir "${PRIVATE_DOTFILES_DIR}/plists"
fi
