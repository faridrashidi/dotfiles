#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/skm"
REPO_CONFIG_DIR="${SCRIPT_DIR}/../home/dot_config/skm"

SKILL_SOURCES=()
SKILL_AGENTS=()

parse_config_file() {
    local file="$1"
    [[ ! -f "$file" ]] && return 0
    local current_section=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%%[[:space:]]#*}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ "$line" =~ ^\[(.*)\]$ ]]; then
            current_section="${BASH_REMATCH[1]}"
            continue
        fi
        [[ "$current_section" == "sources" ]] && SKILL_SOURCES+=("$line")
        [[ "$current_section" == "agents" ]] && SKILL_AGENTS+=("$line")
    done < "$file"
}

load_skm_config() {
    local primary_file=""
    if [[ -f "${CONFIG_DIR}/config" ]]; then
        primary_file="${CONFIG_DIR}/config"
    elif [[ -f "${REPO_CONFIG_DIR}/config" ]]; then
        primary_file="${REPO_CONFIG_DIR}/config"
    fi

    local local_file=""
    if [[ -f "${CONFIG_DIR}/config.local" ]]; then
        local_file="${CONFIG_DIR}/config.local"
    elif [[ -f "${REPO_CONFIG_DIR}/config.local" ]]; then
        local_file="${REPO_CONFIG_DIR}/config.local"
    fi

    [[ -n "$primary_file" ]] && parse_config_file "$primary_file"
    [[ -n "$local_file" ]] && parse_config_file "$local_file"

    if [[ ${#SKILL_AGENTS[@]} -eq 0 ]]; then
        SKILL_AGENTS=("claude-code" "codex" "antigravity-cli")
    fi
}

usage() {
    cat <<'EOF'
Usage: skm [--install|-i]

Without an option, list the globally installed skills.

Options:
  --install, -i  Install the configured skills.
  --help, -h     Display this help message.
EOF
}

fail() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "$1 is not installed."
}

sync_remote_skills() {
    load_skm_config

    if [[ ${#SKILL_SOURCES[@]} -eq 0 ]]; then
        printf 'No skills configured in %s or %s.\n' "$CONFIG_DIR" "$REPO_CONFIG_DIR"
        return 0
    fi

    local skill_source
    for skill_source in "${SKILL_SOURCES[@]}"; do
        skills add "$skill_source" \
            --global \
            --copy \
            --yes \
            --agent "${SKILL_AGENTS[@]}"
    done
}

if [[ $# -gt 1 ]]; then
    fail "expected at most one option"
fi

case "${1:-}" in
    "")
        require_command skills
        skills list --global
        ;;
    -i | --install)
        require_command skills
        sync_remote_skills
        ;;
    -h | --help)
        usage
        ;;
    *)
        fail "unknown option: $1"
        ;;
esac
