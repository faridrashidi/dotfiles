# desktop and hpc profiles

[envs.python]
channels = ["conda-forge"]
dependencies = { python = "==3.12.12" }
exposed = { python = "python", python3 = "python3" }

[envs.node]
channels = ["conda-forge"]
dependencies = { nodejs = "==26.8.1" }
exposed = { node = "node", npm = "npm", npx = "npx" }

[envs.r]
channels = ["conda-forge"]
dependencies = { r-base = "==4.3.3" }
exposed = { R = "R", Rscript = "Rscript" }

[envs.ruby]
channels = ["conda-forge"]
dependencies = { ruby = "==4.0.6" }
exposed = { ruby = "ruby", gem = "gem", bundle = "bundle", bundler = "bundler" }

[envs.rust]
channels = ["conda-forge"]
dependencies = { rust = "==1.98.1" }
exposed = { rustc = "rustc", cargo = "cargo", rustdoc = "rustdoc", rustfmt = "rustfmt" }

[envs.go]
channels = ["conda-forge"]
dependencies = { go = "==1.27.1" }
exposed = { go = "go", gofmt = "gofmt" }

[envs.docker]
channels = ["conda-forge"]
dependencies = { docker-cli = "==29.6.2" }
exposed = { docker = "docker" }

[envs.lazydocker]
channels = ["conda-forge"]
dependencies = { lazydocker = "==0.24.4" }
exposed = { lazydocker = "lazydocker" }

[envs.mutool]
channels = ["conda-forge"]
dependencies = { mupdf = "*" }
exposed = { mutool = "mutool" }

[envs.ouch]
channels = ["conda-forge"]
dependencies = { ouch = "*" }
exposed = { ouch = "ouch" }

[envs.parallel]
channels = ["conda-forge"]
dependencies = { parallel = "*" }
exposed = { parallel = "parallel" }

[envs.rga]
channels = ["conda-forge"]
dependencies = { ripgrep-all = "*", poppler = "*" } # poppler provides pdftotext for PDF search
exposed = { rga = "rga" }

[envs.superfile]
channels = ["conda-forge"]
dependencies = { superfile = "*" }
exposed = { spf = "spf" }

[envs.vd]
channels = ["conda-forge"]
dependencies = { visidata = "*" }
exposed = { vd = "vd" }
{{- end }}
{{- if and (not (get . "hpc")) (ne (get . "profile") "server") }}

# desktop profile

[envs.ffmpeg]
channels = ["conda-forge"]
dependencies = { ffmpeg = "*" }
exposed = { ffmpeg = "ffmpeg", ffprobe = "ffprobe" }

[envs.gcloud]
channels = ["conda-forge"]
dependencies = { google-cloud-sdk = "*" }
exposed = { gcloud = "gcloud", gsutil = "gsutil", bq = "bq" }
{{- end }}
