#!/usr/bin/env zsh

###############################################################################
# 1. Initialization & Path Setup                                              #
###############################################################################

# Deduplicate path arrays
typeset -U PATH path fpath manpath

# Non-login interactive shells still need XDG defaults for cached init and app loaders.
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"

# Load environment variables and application paths before initializing plugins.
[[ -f "$ZDOTDIR/.zprofile" ]] && source "$ZDOTDIR/.zprofile"

# Fingerprint file identity, including replacement by an older tool version.
_cached_eval_file_id() {
    local file
    local -A info
    REPLY=""
    for file in "$@"; do
        if zstat -H info -- "$file" 2>/dev/null; then
            REPLY+="${(q)file}:${info[device]}:${info[inode]}:${info[mode]}:${info[size]}:${info[mtime]}:${info[ctime]};"
        else
            REPLY+="${(q)file}:missing;"
        fi
    done
}

# Cache generated code atomically. Pixi launchers retain their own identity when
# packages change, so resolve their executable once and stat that on cache hits.
_cached_eval() {
    local -a watches args
    while [[ "$1" == "-w" ]]; do
        watches+=("$2")
        shift 2
    done
    local cmd=$1 cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/${1}.zsh"
    shift
    args=("${(@q)@}")
    local executable=${commands[$cmd]} REPLY
    [[ -n "$executable" ]] || return 1
    zmodload -F zsh/stat b:zstat || return 1
    local launcher="${executable:h}/trampoline_configuration/${executable:t}.json"
    local magic old_launcher old_executable old_signature
    if [[ -r "$cache" ]]; then
        {
            IFS= read -r magic
            IFS= read -r old_launcher
            IFS= read -r old_executable
            IFS= read -r old_signature
        } <"$cache"
    fi
    _cached_eval_file_id "$executable" "$launcher"
    local launcher_id=$REPLY
    if [[ -f "$launcher" ]]; then
        if [[ "$magic" == '# cached-eval-v1' && "$old_launcher" == "# $launcher_id" ]]; then
            executable=${(Q)${old_executable#\# }}
        else
            executable=$(command jq -er '.exe' "$launcher") || return 1
        fi
    fi
    _cached_eval_file_id "$executable"
    local identity="$launcher_id$REPLY ${(j: :)args}"
    # fzf's history binding is conditional on whether Atuin owns Ctrl-R.
    [[ "$cmd" == fzf ]] && identity+=" ctrl-r:${+FZF_CTRL_R_COMMAND}:${(q)FZF_CTRL_R_COMMAND}"
    _cached_eval_file_id "${watches[@]}"
    local signature="$identity $REPLY"
    if [[ "$magic" != '# cached-eval-v1' || "$old_signature" != "# $signature" ]]; then
        local generated temporary
        generated=$(command "$cmd" "$@") || return 1
        # Sheldon may create/update its lock file while generating source.
        _cached_eval_file_id "${watches[@]}"
        signature="$identity $REPLY"
        mkdir -p "${cache:h}" || return 1
        temporary=$(mktemp "${cache}.XXXXXX") || return 1
        if ! print -rl -- '# cached-eval-v1' "# $launcher_id" "# ${(q)executable}" \
            "# $signature" "$generated" >"$temporary" ||
            ! mv -f "$temporary" "$cache"; then
            rm -f "$temporary"
            return 1
        fi
    fi
    source "$cache"
}

###############################################################################
# 2. Plugin & Completion Management                                           #
###############################################################################

# Initialize plugins and completions; watch both configured input and resolved lock.
if (($+commands[sheldon])); then
    local _sc="${SHELDON_CONFIG_FILE:-${SHELDON_CONFIG_DIR:-$XDG_CONFIG_HOME/sheldon}/plugins.toml}"
    local _sd="${SHELDON_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/sheldon}"
    _cached_eval -w "$_sc" -w "$_sd/plugins.lock" sheldon source
fi

# Fallback: sheldon absent, or `sheldon source` failed — completions must still work
if (( ! $+functions[compdef] )); then
    autoload -Uz compinit
    () {
        local dumpfile=${ZDOTDIR:-$HOME}/.zcompdump
        local stale=( ${~dumpfile}(N.mh+24) )
        if (( $#stale )); then
            compinit && touch "$dumpfile" # compinit won't refresh an unchanged dump
        else
            compinit -C
        fi
    }
fi

###############################################################################
# 3. Shell Options & Styles                                                   #
###############################################################################

# Menu-select widget for completion menus
zmodload zsh/complist

# Completion matching: exact → case-insensitive → partial-word → substring
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'

# Suppress zsh's built-in menu so fzf-tab can capture the unambiguous prefix.
# See .config/fzf/completions.zsh for the fzf-tab styles themselves.
zstyle ':completion:*' menu no

# ─── History ────────────────────────────────────────────────────────────────
setopt EXTENDED_HISTORY     # Save timestamp and duration
setopt HIST_IGNORE_ALL_DUPS # Remove older duplicate when adding new
setopt HIST_REDUCE_BLANKS   # Remove superfluous blanks before saving
setopt HIST_IGNORE_SPACE    # Don't save commands starting with space
setopt HIST_SAVE_NO_DUPS    # Don't write duplicates to history file
setopt HIST_FIND_NO_DUPS    # Don't show duplicates when searching
setopt SHARE_HISTORY        # Share history between sessions (implies INC_APPEND_HISTORY)

# ─── Directory Navigation ──────────────────────────────────────────────────
setopt AUTOCD            # cd into directory by typing its name
setopt AUTO_PUSHD        # Push dirs to stack on cd
setopt PUSHD_IGNORE_DUPS # Don't push duplicate directories
setopt PUSHD_SILENT      # Don't print dir stack after pushd/popd

# ─── Misc ───────────────────────────────────────────────────────────────────
setopt CORRECT              # Offer spelling correction for commands
setopt INTERACTIVE_COMMENTS # Allow comments in interactive shell
setopt NO_BEEP              # Disable terminal beep

###############################################################################
# 4. Key Bindings                                                             #
###############################################################################

bindkey -e
bindkey -r "^G"

###############################################################################
# 5. Reserved Config Load Order                                               #
###############################################################################

_source_named_configs() {
    local name file
    for name in "$@"; do
        file="$ZDOTDIR/$name"
        [[ -f "$file" ]] && source "$file"
        for file in "$XDG_CONFIG_HOME"/*/"$name"(N); do
            [[ "${file:h:t}" == zsh ]] && continue
            source "$file"
        done
    done
}

_source_named_configs completions.zsh functions.zsh init.zsh aliases.zsh binders.zsh
unfunction _source_named_configs
