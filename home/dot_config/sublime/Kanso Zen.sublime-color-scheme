{
  "name": "Kanso Zen",
  "type": "dark",
  "variables": {
    "background": "#181616",
    "foreground": "#C5C9C7",
    "surface": "#181616",
    "selection": "#393B44",
    "line": "#22262D",
    "caret": "#f2f1ef",
    "comment": "#75797f",
    "keyword": "#8992a7",
    "string": "#8a9a7b",
    "constant": "#b6927b",
    "function": "#8ba4b0",
    "type": "#8ea4a2",
    "variable": "#C5C9C7",
    "invalid": "#C34043",
    "punctuation": "#909398",
    "number": "#a292a3",
    "operator": "#909398",
    "macro": "#909398",
    "parameter": "#909398"
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "var(caret)",
    "gutter": "var(surface)",
    "gutter_foreground": "var(comment)",
    "line_highlight": "var(line)",
    "selection": "var(selection)",
    "selection_foreground": "var(foreground)"
  },
  "rules": [
    {"scope": "comment", "foreground": "var(comment)", "font_style": "italic"},
    {"scope": "keyword, storage", "foreground": "var(keyword)", "font_style": "italic"},
    {"scope": "string", "foreground": "var(string)"},
    {"scope": "constant, support.constant, entity.name", "foreground": "var(constant)"},
    {"scope": "entity.name.function, support.function, variable.function", "foreground": "var(function)"},
    {"scope": "entity.name.type, entity.name.class, support.type, support.class", "foreground": "var(type)"},
    {"scope": "variable", "foreground": "var(variable)"},
    {"scope": "variable.parameter", "foreground": "var(parameter)"},
    {"scope": "punctuation", "foreground": "var(punctuation)"},
    {"scope": "invalid", "foreground": "var(invalid)"},
    {"scope": "markup.heading", "foreground": "var(function)", "font_style": "bold"},
    {"scope": "markup.bold", "font_style": "bold"},
    {"scope": "markup.italic", "font_style": "italic"},
    {"scope": "constant.numeric", "foreground": "var(number)"},
    {"scope": "keyword.operator, entity.name.tag", "foreground": "var(operator)", "font_style": "normal"},
    {"scope": "entity.name.function.macro", "foreground": "var(macro)"}
  ]
}
