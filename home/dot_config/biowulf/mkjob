#!/usr/bin/env bash

set -euo pipefail
set -o noclobber

CPU=8 TIME="0-2:00:00" MEM=50 NAME="helper" DIR=$(pwd)
FORCE=false

usage() {
    cat <<EOF
Usage: $0 [slurm|swarm|pbs|info] [OPTIONS]

Options:
  --cpu NUM       CPUs (default: 8)
  --time TIME     Time (default: 0-2:00:00)
  --mem NUM       Memory in GB (default: 50)
  --name NAME     Job name (default: helper)
  --force         Replace an existing regular job script (symlinks are refused)
EOF
}

prepare_output() {
    local output="$1"
    if [[ -L "$output" || ( -e "$output" && ! -f "$output" ) ]]; then
        printf 'Error: refusing to replace a symlink or non-regular file: %s\n' "$output" >&2
        exit 1
    fi
    if [[ -e "$output" ]]; then
        if [[ "$FORCE" != true ]]; then
            printf 'Error: %s already exists; use --force to replace it.\n' "$output" >&2
            exit 1
        fi
        rm -f -- "$output"
    fi
}

[[ $# -lt 1 ]] && {
    usage
    exit 1
}

COMMAND=$1
shift

while [[ $# -gt 0 ]]; do
    case "$1" in
        --cpu | --time | --mem | --name)
            if [[ $# -lt 2 || -z "$2" || "$2" == --* ]]; then
                printf 'Error: %s requires a value.\n' "$1" >&2
                exit 1
            fi
            ;;
    esac
    case "$1" in
        --cpu)
            CPU="$2"
            shift 2
            ;;
        --time)
            TIME="$2"
            shift 2
            ;;
        --mem)
            MEM="$2"
            shift 2
            ;;
        --name)
            NAME="$2"
            shift 2
            ;;
        --force)
            FORCE=true
            shift
            ;;
        *)
            echo "Unknown option: $1"
            usage
            exit 1
            ;;
    esac
done

case "$COMMAND" in
    slurm)
        prepare_output _sbatch.sh
        cat >_sbatch.sh <<EOF
#!/bin/bash

#SBATCH --cpus-per-task=${CPU}
#SBATCH --time=${TIME}
#SBATCH --gres=lscratch:1
#SBATCH --mem=${MEM}g
#SBATCH --job-name=${NAME}
#SBATCH --partition=norm
#SBATCH --chdir=${DIR}
#SBATCH --output=${DIR}/_sbatch.log
#SBATCH --error=${DIR}/_sbatch.log
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --ntasks-per-core=1
#SBATCH --ntasks=1

module load snpEff/5.0
EOF
        echo "Created _sbatch.sh"
        ;;

    swarm)
        prepare_output _swarm.sh
        cat >_swarm.sh <<EOF
#!/bin/bash

# swarm \\
#	--file ${DIR}/_swarm.sh \\
#	--logdir ${DIR}/_swarm \\
#	--time ${TIME} \\
#	--gres=lscratch:1 \\
#	--gb-per-process ${MEM} \\
#	--threads-per-process ${CPU} \\
#	--module GATK/4.2.0.0 \\
#	--bundle 1 --partition norm --processes-per-subjob 1 --noht \\
#	--sbatch "--mail-type=BEGIN,END,FAIL --job-name=${NAME}"

echo hello && echo Done
EOF
        echo "Created _swarm.sh"
        ;;

    pbs)
        prepare_output _qsub.sh
        cat >_qsub.sh <<EOF
#!/bin/bash

#PBS -l ppn=${CPU}
#PBS -l walltime=${TIME}
#PBS -l vmem=${MEM}gb
#PBS -N ${NAME}
#PBS -q norm
#PBS -d ${DIR}
#PBS -o ${DIR}/_qsub.log
#PBS -e ${DIR}/_qsub.log
#PBS -m a
#PBS -l nodes=1

module load snpEff/5.0
EOF
        echo "Created _qsub.sh"
        ;;

    info)
        echo "Guide where to download the human/mouse database."
        ;;

    *)
        echo "Invalid command: $COMMAND"
        usage
        exit 1
        ;;
esac
