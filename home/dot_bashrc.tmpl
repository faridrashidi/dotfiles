if [[ $- == *i* ]] && [[ "$BASH_EXEC_ZSH" != 1 ]]; then
    # Prefer Pixi's zsh; fresh cloud images usually don't ship one.
    ZSH_PATH={{ get . "pixi_home" | default (print .chezmoi.homeDir "/.pixi") | quote }}/bin/zsh
    [ -x "$ZSH_PATH" ] || ZSH_PATH=$(command -v zsh)
    if [ -x "$ZSH_PATH" ]; then
        export BASH_EXEC_ZSH=1
        export SHELL="$ZSH_PATH"
        exec "$ZSH_PATH" -l
    fi
fi
