{{- $pixiHome := get . "pixi_home" -}}
{{- if not $pixiHome -}}
{{- $pixiHome = printf "%s/.pixi" (env "HOME") -}}
{{- end -}}
if [[ $- == *i* ]] && [[ "${BASH_EXEC_ZSH:-}" != 1 ]]; then
    ZSH_PATH={{ printf "%s/bin/zsh" $pixiHome | quote }}
    if [[ ! -x "$ZSH_PATH" ]]; then
        ZSH_PATH="$(command -v zsh 2>/dev/null || true)"
    fi
    if [[ -x "$ZSH_PATH" ]]; then
        export BASH_EXEC_ZSH=1
        export SHELL="$ZSH_PATH"
        exec "$ZSH_PATH" -l
    fi
fi
