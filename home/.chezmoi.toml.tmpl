{{- $gitName := promptStringOnce . "git.name" "Git name" "" -}}
{{- $gitEmail := promptStringOnce . "git.email" "Git email" "" -}}
{{- if or (eq (trim $gitName) "") (eq (lower (trim $gitName)) "name") (eq (trim $gitEmail) "") (eq (lower (trim $gitEmail)) "email") -}}
{{- fail "Git name and email must be set and must not use the placeholders name/email. Run chezmoi init --prompt to set them." -}}
{{- end -}}
{{- $touchIDSudo := false -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $touchIDSudo = promptBoolOnce . "touch_id_sudo" "Enable Touch ID for sudo?" true -}}
{{- end -}}
{{- $profile := "desktop" -}}
{{- if ne .chezmoi.os "darwin" -}}
{{- $defaultProfile := "desktop" -}}
{{- if get . "hpc" -}}
{{- $defaultProfile = "hpc" -}}
{{- end -}}
{{- $profile = promptChoiceOnce . "profile" "Profile" (list "desktop" "server" "hpc") $defaultProfile -}}
{{- end -}}
{{- $hpc := eq $profile "hpc" -}}
{{- $defaultPixiHome := printf "%s/.pixi" (env "HOME") -}}
{{- if $hpc -}}
{{- $defaultPixiHome = printf "/data/%s/.pixi" (env "USER") -}}
{{- end -}}
{{- if env "PIXI_HOME" -}}
{{- $defaultPixiHome = env "PIXI_HOME" -}}
{{- end -}}
{{- $pixiHome := promptStringOnce . "pixi_home" "PIXI_HOME" $defaultPixiHome -}}

mode = "symlink"
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
hpc = {{ $hpc }}
profile = {{ $profile | quote }}
pixi_home = {{ $pixiHome | quote }}
touch_id_sudo = {{ $touchIDSudo }}

[data.git]
name = {{ $gitName | quote }}
email = {{ $gitEmail | quote }}
