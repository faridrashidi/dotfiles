# Deduplicate path arrays across all shells
typeset -U path fpath manpath

export ZDOTDIR="$HOME/.config/zsh"

# XDG environment defaults
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

{{- $pixiHome := get . "pixi_home" -}}
{{- if $pixiHome }}
export PIXI_HOME={{ $pixiHome | quote }}
{{- else }}
export PIXI_HOME="$HOME/.pixi"
{{- end }}

# Load core binary paths in all shells. Login shells load this again from
# .zprofile after macOS path_helper rebuilds PATH.
[[ -f "$ZDOTDIR/path.zsh" ]] && source "$ZDOTDIR/path.zsh"

export LANG="en_US.UTF-8"
export COLORTERM=truecolor
export EDITOR="nvim"
export VISUAL="code --wait"
